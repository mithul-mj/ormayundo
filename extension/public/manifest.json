{
  "manifest_version": 3,
  "name": "Ormayundo Active Recall",
  "version": "1.0",
  "description": "An AI-powered active recall and spaced repetition extension.",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "Ormayundo",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "notifications",
    "contextMenus",
    "identity"
  ],
  "host_permissions": [
    "https://ormayundo.onrender.com/*"
  ],
  "oauth2": {
    "client_id": "784997529921-3qi0jjsaldb00od0gv81lqh563uo8nmc.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email"
    ]
  }
}