# Ormayundo Backend Environment Variables
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/rewire
JWT_SECRET=your_jwt_access_secret_key
REFRESH_TOKEN_SECRET=your_jwt_refresh_secret_key
AI_API_KEY=your_groq_api_key
REDIS_URL=redis://default:<password>@<host>:<port>

# Administrator Credentials (Used by seed script: npm run seed:admin)
ADMIN_EMAIL=admin@ormayundo.com
ADMIN_PASSWORD=Admin@Ormayundo2026!
